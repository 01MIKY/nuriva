# NURIVA API configuration. Copy to .env for local development. NEVER commit real values.
# In staging these are Render environment variables (render.yaml, docs/DEPLOY.md); never files in the repo.

NURIVA_ENV=development            # development | test | staging | production
PORT=4000
DATABASE_URL=postgres://nuriva_dev:nuriva_dev_local_only@localhost:5432/nuriva_dev

# Field-encryption keyring: "<keyId>:<base64 32 bytes>", comma-separated, first = primary.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NURIVA_DATA_KEYS=dev1:REPLACE_WITH_BASE64_32_BYTES
# Alternative for hosts that generate one random base64 secret: NURIVA_DATA_KEY=<base64> + NURIVA_DATA_KEY_ID=stg1

APP_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
TERMS_VERSION=2026-11-draft
AUTH_RATE_LIMIT=10
RATE_LIMIT_PER_MINUTE=300
# Proxies in front of the API. The web/admin apps forward ONE resolved visitor address, so the default is 1.
# TRUSTED_PROXY_HOPS=1
# BOOKINGS_ENABLED=false   # default off in staging/production until payments are connected
SESSION_TTL_HOURS=168

# --- Payments (Stripe Connect, ADR 0003). TEST keys only outside production. ---
PAYMENTS_PROVIDER=stripe          # 'fake' is allowed only in automated tests
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# In a Claude Code cloud session the key is injected by the network proxy: use STRIPE_SECRET_KEY=proxy-injected
# and start the API with NODE_USE_ENV_PROXY=1 so Node's fetch uses the proxy.
STRIPE_API_VERSION_V2=2026-10-28.preview
# PAYMENTS_ENABLED=false          # default off in staging/production until approved
WEB_ORIGIN=http://localhost:3000  # used for Stripe return URLs
# Stripe event destination signing secret (whsec_...). Required in staging/production when payments are on.
# Create TWO destinations in the Stripe dashboard pointing to https://<api-domain>/v1/webhooks/stripe:
#   1) Thin events from connected accounts: v2.core.account.updated, v2.core.account[configuration.merchant].capability_status_updated
#   2) Snapshot events from connected accounts (Connect): checkout.session.completed, checkout.session.async_payment_succeeded
# If they have different secrets, run one API route per secret or reuse one destination (see docs/INTEGRATIONS.md).
# STRIPE_WEBHOOK_SECRET=whsec_...
# CHECKR_API_KEY=...            (Checkr staging environment)
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=...
# POSTMARK_SERVER_TOKEN=...

# --- Web and admin apps (Next.js) ---
# API_ORIGIN=http://localhost:4000   # or a private-network host:port, e.g. nuriva-staging-api:10000
# CLIENT_IP_HEADER=cf-connecting-ip   # only if the hosting edge overwrites this header on every request
# EDGE_PROXY_HOPS=1                   # otherwise: X-Forwarded-For entry counted from the right
# NURIVA_ENV=staging                  # shows the "test version" banner and blocks search indexing
