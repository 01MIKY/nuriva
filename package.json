{
  "name": "nuriva",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint:i18n": "pnpm --filter @nuriva/i18n test",
    "db:generate": "pnpm --filter @nuriva/db generate",
    "db:migrate": "pnpm --filter @nuriva/db migrate",
    "dev:api": "pnpm --filter @nuriva/api dev",
    "e2e": "pnpm --filter @nuriva/web build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
